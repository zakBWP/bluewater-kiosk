{
  "name": "bluewater-kiosk",
  "productName": "Bluewater Kiosk",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --windowed",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac dir --publish never"
  },
  "build": {
    "appId": "com.bluewaterkiosk.app",
    "files": [
      "main.js",
      "preload.cjs",
      "src/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "bwp",
        "name": "Bluewater Kiosk Job",
        "description": "Bluewater Kiosk job",
        "role": "Editor"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "publish": {
      "provider": "github",
      "owner": "zakBWP",
      "repo": "bluewater-kiosk",
      "releaseType": "release"
    },
    "mac": {
      "identity": "-",
      "hardenedRuntime": false
    }
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.8.9",
    "koffi": "^3.3.2",
    "node-thermal-printer": "^4.6.1",
    "qrcode": "^1.5.4",
    "usb": "^3.2.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "koffi@3.3.2": true
  }
}

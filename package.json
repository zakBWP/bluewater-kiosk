{
  "name": "bluewater-kiosk",
  "productName": "Bluewater Kiosk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --windowed",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
